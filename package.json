{
  "name": "fieldwork-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:sites": "npm run build:cloudflare && wrangler deploy --dry-run --outdir .worker-bundle && node scripts/package-sites.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@supabase/supabase-js": "^2.110.0",
    "@aws-sdk/client-s3": "^3.1000.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "wrangler": "^4.92.0"
  }
}
